// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// PostGIS integration: `postgresqlExtensions` is enabled and the `postgis`
// extension is declared on the datasource per
// specs/003-database-foundation/research.md Decision 1. Geometry columns use
// Prisma's `Unsupported("geometry(...)")` type and are read/written via raw
// SQL — see src/server/repositories/featureRepository.ts (added in Phase 5).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

/// Owns projects. Account/login is out of scope this phase — see
/// src/server/auth/getCurrentUser.ts and research.md Decision 6.
model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // specs/006-collaboration — additive back-relations only.
  memberships         ProjectMember[]
  sentInvitations     Invitation[]    @relation("InvitationSender")
  receivedInvitations Invitation[]    @relation("InvitationRecipient")
  comments            Comment[]
  activities          Activity[]
  versions            Version[]
  notifications       Notification[]
  featureLocks        FeatureLock[]
  presenceSessions    Presence[]

  // specs/007-spatial-analysis — additive back-relations only.
  analysisRuns       AnalysisRun[]
  analysisPresets    AnalysisPreset[]
  measurementHistory MeasurementHistory[]
  exportJobs         ExportJob[]

  // specs/005-import-export — additive back-relation only.
  importJobs ImportJob[]

  // specs/008-dashboard-analytics — additive back-relations only.
  dashboards             Dashboard[]         @relation("DashboardOwner")
  dashboardShares        DashboardShare[]    @relation("DashboardShareRecipient")
  dashboardSharesGranted DashboardShare[]    @relation("DashboardShareGranter")
  dashboardFavorites     DashboardFavorite[]
  reports                Report[]
  scheduledReports       ScheduledReport[]
}

/// Root data-hierarchy container (User 1──* Project 1──* Layer 1──* Feature).
/// Name is unique per owner (FR-002); deleting a project cascades to every
/// layer/feature/attribute/style nested beneath it (Research Decision 7).
model Project {
  id           String        @id @default(cuid())
  name         String
  description  String?
  ownerId      String
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  layers       Layer[]
  analysisRuns AnalysisRun[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // specs/006-collaboration — additive back-relations only.
  members     ProjectMember[]
  invitations Invitation[]
  activities  Activity[]
  versions    Version[]
  presence    Presence[]

  // specs/007-spatial-analysis — additive back-relations only.
  analysisPresets    AnalysisPreset[]
  measurementHistory MeasurementHistory[]
  exportJobs         ExportJob[]

  // specs/005-import-export — additive back-relation only.
  importJobs ImportJob[]

  // specs/008-dashboard-analytics — additive back-relations only.
  dashboards         Dashboard[]
  analyticsSnapshots AnalyticsSnapshot[]

  @@unique([ownerId, name])
  @@index([ownerId])
}

/// Named grouping of spatial data within one Project. `order` determines
/// draw/list order among sibling layers (FR-011); a layer may contain
/// features of more than one geometry type (FR-012, confirmed clarification).
model Layer {
  id                   String        @id @default(cuid())
  name                 String
  order                Int
  projectId            String
  project              Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  features             Feature[]
  resultOfAnalysisRuns AnalysisRun[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  // specs/007-spatial-analysis — additive back-relation only.
  sourceOfExportJobs ExportJob[] @relation("ExportJobSourceLayer")

  // specs/005-import-export — additive back-relation only. Named to match
  // ExportJob's existing "ExportJobSourceLayer" convention. Set-null on the
  // owning side, so deleting a layer never deletes its import history (FR-079).
  targetOfImportJobs ImportJob[] @relation("ImportJobTargetLayer")

  @@unique([projectId, name])
  @@index([projectId, order])
}

/// A single spatial record belonging to one Layer. `geometry` is a native
/// PostGIS column (Research Decision 1) — Prisma's generated client cannot
/// read/write it directly; all access goes through raw SQL in
/// featureRepository.ts. SRID is fixed at 4326 platform-wide (FR-016).
model Feature {
  id         String                                  @id @default(cuid())
  layerId    String
  layer      Layer                                   @relation(fields: [layerId], references: [id], onDelete: Cascade)
  geometry   Unsupported("geometry(Geometry, 4326)")
  attributes FeatureAttribute[]
  style      FeatureStyle?
  createdAt  DateTime                                @default(now())
  updatedAt  DateTime                                @updatedAt

  // specs/006-collaboration — additive back-relations only.
  comments Comment[]
  lock     FeatureLock?

  // specs/005-import-export — feature provenance (research.md Decision 14).
  //
  // NULL means "not created by a tracked import": every feature that exists
  // today, plus every feature drawn in Map Editing or produced by an analysis
  // run. Nullable with no default, so `createFeature`, `updateFeature`,
  // `importFeatures`, and every analysis result-layer writer keep working
  // untouched — only `commitImportChunk` sets it.
  //
  // SetNull, never Cascade: deleting a history entry must never delete map
  // data. The reverse direction — deleting the features one import created —
  // is the explicit "Undo this import" action, which deletes by this column
  // (FR-072). Row-level provenance is the only thing that can guarantee a
  // rollback removes exactly that import's features while a concurrent user's
  // additions to the same layer survive (SC-011).
  importJobId String?
  importJob   ImportJob? @relation(fields: [importJobId], references: [id], onDelete: SetNull)

  @@index([layerId])
  /// Carries the rollback delete (FR-072). Without it, undoing a 1,000-feature
  /// import inside a 500,000-feature layer is a sequential scan.
  @@index([importJobId])
}

/// A single free-form name/value pair belonging to one Feature (Research
/// Decision 12 — normalized child table, not a per-layer fixed schema).
/// Two features in the same layer are not required to share attribute names.
model FeatureAttribute {
  id        String  @id @default(cuid())
  featureId String
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  key       String
  value     String

  @@unique([featureId, key])
  @@index([featureId])
}

/// Visual styling for one Feature (one-to-one). A Feature with no
/// FeatureStyle row uses the documented platform-wide default (FR-023).
model FeatureStyle {
  id          String  @id @default(cuid())
  featureId   String  @unique
  feature     Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  color       String
  strokeWidth Float?
  fillOpacity Float?
}

/// A single geoprocessing operation run within one Project (spec
/// 005-spatial-analysis-geoprocessing, widened by 007-spatial-analysis).
/// Covers every spec-level concept from both features — a single Analysis
/// Run, a Batch Run (a group of rows sharing `batchId`), an Analysis
/// History entry (this row, viewed through the project-scoped listing
/// query), a background job (`status`/`progress`/`cancelRequestedAt`/
/// `backendPid`), "AnalysisStatistics" (US6 — a statistics `operationType`
/// whose result lives in `resultData`, not a new table), and
/// "GeometryOperation" (US5 — likewise just an `operationType` value) — per
/// research.md Decision 1, so no separate BatchRun/HistoryEntry/
/// AnalysisJob/AnalysisStatistics/GeometryOperation table exists.
/// `resultLayerId` is set only when the operation produced new geometry;
/// `resultData` holds tabular, non-geometry results (Distance Matrix, CRS
/// Transformation preview, statistics summaries).
model AnalysisRun {
  id                String          @id @default(cuid())
  projectId         String
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  operationType     String
  status            String
  progress          Int?
  parameters        Json
  inputLayerIds     Json
  resultLayerId     String?
  resultLayer       Layer?          @relation(fields: [resultLayerId], references: [id], onDelete: SetNull)
  resultData        Json?
  errorMessage      String?
  batchId           String?
  presetId          String?
  preset            AnalysisPreset? @relation(fields: [presetId], references: [id], onDelete: SetNull)
  startedAt         DateTime?
  completedAt       DateTime?
  executionTimeMs   Int?
  cancelRequestedAt DateTime?
  backendPid        Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // specs/007-spatial-analysis
  exportJobs ExportJob[]

  @@index([projectId, createdAt])
  @@index([batchId])
  /// "show running/queued jobs for this project" (Progress Dialog, History
  /// Panel status filter) without scanning completed history — also the
  /// query "Analysis History" itself runs through (research.md Decision 1).
  ///
  /// `createdAt` is the third column (T260): history is always ordered
  /// newest-first, and on `[projectId, status]` alone the planner ignored
  /// this index in favour of `[projectId, createdAt]` — satisfying the
  /// sort but filtering status row by row through the heap. With the sort
  /// key in the index, one scan serves both the filter and the ordering.
  @@index([projectId, status, createdAt])
  /// "my analyses" queries and the per-user concurrent-job cap check
  /// (research.md Decision 12).
  @@index([userId])
  /// "runs launched from this preset."
  @@index([presetId])
}

/// A named, reusable `(operationType, parameters)` pair scoped to a user and
/// project (US8/FR-021, specs/007-spatial-analysis) — created once, read
/// many times, never itself executed. Deleting a preset never deletes the
/// runs launched from it (`AnalysisRun.presetId` is set-null).
model AnalysisPreset {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  operationType String
  parameters    Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  analysisRuns AnalysisRun[]

  @@unique([projectId, name])
  @@index([projectId, operationType])
}

/// An explicitly saved measurement reading (US3/FR-008, specs/007-spatial-
/// analysis; research.md Decision 8 — the persisted `value` is always
/// server-recomputed via PostGIS at save time, never the client's live
/// estimate taken on faith). `geometry` uses the identical PostGIS column
/// pattern as `Feature.geometry` (Constitution Principle III) so a saved
/// measurement can be re-displayed on the map.
model MeasurementHistory {
  id              String                                  @id @default(cuid())
  projectId       String
  project         Project                                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId          String
  user            User                                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  measurementType String
  geometry        Unsupported("geometry(Geometry, 4326)")
  value           Float?
  unit            String?
  label           String?
  createdAt       DateTime                                @default(now())

  @@index([projectId, createdAt])
}

/// A lightweight, client-reported log entry for a completed export (US9,
/// specs/007-spatial-analysis; research.md Decision 10, revised) — the
/// client does all export work itself (paginated fetch + in-browser
/// serialization); this row exists purely for after-the-fact history/audit
/// visibility, matching `AnalysisRun`'s history philosophy. `status` is
/// always written already-terminal — there is no `queued`/`running` phase
/// to poll, because no server execution phase exists for exports.
model ExportJob {
  id                  String       @id @default(cuid())
  projectId           String
  project             Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceAnalysisRunId String?
  sourceAnalysisRun   AnalysisRun? @relation(fields: [sourceAnalysisRunId], references: [id], onDelete: SetNull)
  sourceLayerId       String?
  sourceLayer         Layer?       @relation("ExportJobSourceLayer", fields: [sourceLayerId], references: [id], onDelete: SetNull)
  format              String
  status              String
  featureCount        Int?
  errorMessage        String?
  createdAt           DateTime     @default(now())

  // ---- specs/005-import-export additions (T018) — additive only ----
  //
  // `format` already admits "pdf" without a schema change: it is a String
  // column, so widening it is a Zod/validation change (FR-034).
  //
  // These three carry no backfill cost — `scope` is defaulted to what every
  // pre-existing row was, and the other two are nullable.

  /// "selection" | "layer" | "project" (FR-035).
  scope      String  @default("layer")
  /// Authority code the file was written in, e.g. "EPSG:4326" (FR-041). Null
  /// on pre-existing rows, which were all WGS84 by construction.
  outputCrs  String?
  /// Project scope only (FR-037) — how many layers the archive contains, so
  /// history can show "4 layers, 12,830 features" without reopening it.
  layerCount Int?

  @@index([projectId, createdAt])
}

// ---------------------------------------------------------------------------
// GIS Import & Export (specs/005-import-export)
//
// Two new models. `ImportJob` rows ARE the import history — there is no
// separate ImportHistory table, no FileMetadata table, and no ExportStatistics
// table (research.md Decision 15, applying 007's Decision 1 again: a job row
// that is never deleted IS a history row, and a parallel table would need
// writing twice and would drift). Export history is the existing `ExportJob`
// above, extended in place.
//
// No uploaded file bytes are stored anywhere. All five formats are parsed in
// the browser and reach the server as normalized JSON chunks (research.md
// Decision 2), so `ImportJob`'s file* columns are provenance metadata only.
// ---------------------------------------------------------------------------

/// One user-initiated import of one file into one layer (US1–US4, US9, US10).
/// The browser tab executes the import; this row is the job's system of record
/// (research.md Decision 3), which is what makes progress visible after a
/// reload and what `Feature.importJobId` points at for rollback.
model ImportJob {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Set-null, not cascade: FR-079 requires the history entry to survive its
  /// target layer's deletion. `targetLayerName` preserves what the layer was
  /// called so the entry stays readable afterwards.
  targetLayerId   String?
  targetLayer     Layer?  @relation("ImportJobTargetLayer", fields: [targetLayerId], references: [id], onDelete: SetNull)
  targetLayerName String

  /// "geojson" | "shapefile" | "kml" | "kmz" | "csv" (FR-001).
  sourceFormat  String
  fileName      String
  fileSizeBytes Int
  mimeType      String?
  /// SHA-256 of the source file, computed client-side. Provenance/audit only —
  /// never used to skip work, and never accompanied by the bytes themselves.
  fileHash      String?

  /// Authority code of the source CRS, e.g. "EPSG:4326" (FR-060–FR-062).
  /// Applied server-side via ST_Transform at chunk-commit time, never by the
  /// client — Constitution Principle IV (research.md Decision 4).
  sourceCrs           String
  /// Populated only when the user supplied a definition outside the catalog
  /// (FR-063); passed to ST_Transform as proj4 text instead of an SRID.
  customCrsDefinition String?

  /// "strict" | "lenient" (FR-006). Lenient is the platform default. Strict is
  /// enforced by auto-rollback on the first commit-time rejection (research.md
  /// Decision 6), so this column records intent, not a different write path.
  mode String @default("lenient")

  /// CSV only (FR-029, FR-030): { latitudeColumn, longitudeColumn, delimiter,
  /// hasHeaderRow, attributeColumns[] }. Retained so a past import's
  /// interpretation is reproducible (spec.md Key Entities).
  columnMapping Json?

  /// "running" | "succeeded" | "failed" | "cancelled" | "rolled_back".
  /// `running` is the only non-terminal state; there is no `queued` state
  /// because there is no queue. "abandoned" is a derived presentation of a
  /// stale `running` row, never a stored value (research.md Decision 17).
  status String @default("running")

  /// Total features the client's preflight found. The denominator for every
  /// progress readout (FR-009) — a display value, never a correctness input.
  totalFeatures   Int?
  importedCount   Int  @default(0)
  rejectedCount   Int  @default(0)
  duplicateCount  Int  @default(0)
  repairedCount   Int  @default(0)
  /// Highest committed chunk index — the idempotency key for chunk retries,
  /// which are routine across the ~100 requests a large import makes.
  chunksCommitted Int  @default(0)

  errorMessage      String?
  /// Set by POST /cancel. Any further chunk POST for this job is rejected with
  /// CONFLICT, so cancellation is a server guarantee, not client politeness
  /// (research.md Decision 13).
  cancelRequestedAt DateTime?
  /// Bumped on every chunk commit. A `running` row older than the abandoned
  /// threshold is swept to `failed` on the next history read (FR-074).
  heartbeatAt       DateTime?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  issues   ImportIssue[]
  features Feature[]

  @@index([projectId, createdAt])
  /// Filter-plus-sort for "running imports in this project" without scanning
  /// completed history. `createdAt` is the third column for the reason
  /// established on AnalysisRun: on [projectId, status] alone the planner
  /// prefers [projectId, createdAt] to satisfy the newest-first ordering and
  /// then filters status row by row through the heap.
  @@index([projectId, status, createdAt])
  @@index([userId])
  @@index([targetLayerId])
}

/// One validation finding against one source feature or CSV row (FR-057–FR-059).
/// Named "issue" rather than "error" because it also carries non-failure
/// categories — `duplicate_in_file`, `repaired_geometry`, `sanitized_attribute`
/// are reported and counted but are not rejections.
///
/// Capped at IMPORT_MAX_PERSISTED_ISSUES (1,000) rows per job at write time: a
/// 100,000-row CSV with a mis-mapped coordinate column would otherwise write
/// more issue rows than the import itself, turning a user error into a
/// database-growth incident (research.md Decision 16). ImportJob's counters
/// stay exact regardless of the cap.
model ImportIssue {
  id          String    @id @default(cuid())
  importJobId String
  importJob   ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  /// Zero-based feature index for GeoJSON/Shapefile/KML, 1-based line number
  /// for CSV — whichever the user can actually find in their own file (FR-033).
  sourcePosition Int

  /// One of the eleven categories in `shared/contracts/importIssue.schema.ts`.
  category String

  /// User-safe text. Never a raw driver or parser error string (FR-086).
  message   String
  createdAt DateTime @default(now())

  /// Serves both "list this job's issues in source order" and the cursor
  /// paging the issues endpoint uses — one scan for the filter and the sort.
  @@index([importJobId, sourcePosition])
}

// ---------------------------------------------------------------------------
// Real-Time Collaboration (specs/006-collaboration)
//
// Multi-user access to a Project. `ProjectMember` broadens access beyond
// `Project.ownerId` (research.md Decision 10 — the existing ownership-scoped
// repository functions are updated to also recognize an active membership
// row, additively, no signature change). See data-model.md for the full
// cascade-vs-restrict rationale repeated per model below.
// ---------------------------------------------------------------------------

/// Grants a User access to a Project beyond its owner (FR-004). Exactly one
/// member per project has role "Owner", kept in sync with `Project.ownerId`.
/// Cascades on User delete (Edge Cases: deleted users hold no membership).
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

/// A pending/resolved invitation to join a Project (FR-010–FR-012).
/// `invitedByUserId` uses Restrict (attribution survives); `invitedUserId`
/// cascades (a deleted user should hold no pending invitation).
model Invitation {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedByUserId String
  invitedBy       User     @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  invitedUserId   String
  invitedUser     User     @relation("InvitationRecipient", fields: [invitedUserId], references: [id], onDelete: Cascade)
  role            String
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
  @@index([invitedUserId, status])
}

/// A threaded comment on one Feature (US6). `authorId` uses Restrict —
/// attribution is a historical record (FR-048-equivalent for comments).
model Comment {
  id               String    @id @default(cuid())
  featureId        String
  feature          Feature   @relation(fields: [featureId], references: [id], onDelete: Cascade)
  authorId         String
  author           User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  parentCommentId  String?
  parentComment    Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies          Comment[] @relation("CommentReplies")
  body             String
  resolved         Boolean   @default(false)
  mentionedUserIds Json      @default("[]")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([featureId])
  @@index([authorId])
  @@index([parentCommentId])
}

/// Append-only audit record for a Project (FR-023, FR-047). Never updated or
/// deleted by any code path — `userId` uses Restrict so attribution survives.
model Activity {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([userId])
}

/// An immutable, full-snapshot save point for a Project (FR-026–FR-029).
/// Never deleted by any code path. `createdByUserId` uses Restrict.
model Version {
  id                   String   @id @default(cuid())
  projectId            String
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdByUserId      String
  createdBy            User     @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  note                 String?
  snapshot             Json
  isPreRestoreSnapshot Boolean  @default(false)
  createdAt            DateTime @default(now())

  @@index([projectId, createdAt])
}

/// An in-app notification for one recipient (FR-036–FR-038). Cascades on
/// User delete (a removed user holds no pending notifications).
model Notification {
  id              String   @id @default(cuid())
  recipientUserId String
  recipient       User     @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  type            String
  payload         Json
  read            Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([recipientUserId, read])
  @@index([recipientUserId, createdAt])
}

/// At most one active lock per Feature (US3, research.md Decision 4).
/// `updateFeature`/`deleteFeature` gain a guard clause checking this table.
/// `expiresAt` is a rolling timeout, checked at read time — a lock past this
/// timestamp is treated as already released. Cascades on User delete.
model FeatureLock {
  id             String   @id @default(cuid())
  featureId      String   @unique
  feature        Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  lockedByUserId String
  lockedBy       User     @relation(fields: [lockedByUserId], references: [id], onDelete: Cascade)
  acquiredAt     DateTime @default(now())
  expiresAt      DateTime
}

/// A member's ephemeral live presence within a Project (US9, research.md
/// Decision 3) — cursor, viewport, currently-edited feature. A row older
/// than the 30s timeout (spec Assumptions) is treated as offline at read
/// time; no dedicated cleanup job. Cascades on User delete.
model Presence {
  id               String   @id @default(cuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cursorLng        Float?
  cursorLat        Float?
  viewportBounds   Json?
  currentFeatureId String?
  lastSeenAt       DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId, lastSeenAt])
}

// ---------------------------------------------------------------------------
// Enterprise Deployment & Production Operations (specs/010-deployment-enterprise)
//
// Platform-wide, non-project-scoped operational tables — infrastructure
// deployment/release tracking, health/metrics, centralized logs,
// infrastructure-level backups, maintenance windows, and notifications. See
// data-model.md / research.md Decision 0 for how these relate to (and stay
// non-duplicative of) 009-administration-security's application-level
// `Backup`/`SecurityAuditLog` concepts.
// ---------------------------------------------------------------------------

enum Environment {
  DEVELOPMENT
  TESTING
  STAGING
  PRODUCTION
}

enum DeploymentStatus {
  PENDING
  IN_PROGRESS
  SUCCEEDED
  FAILED
  ROLLED_BACK
}

enum HealthComponent {
  APPLICATION
  DATABASE
  API
}

enum HealthStatus {
  HEALTHY
  DEGRADED
  UNHEALTHY
}

enum LogCategory {
  APPLICATION
  DATABASE
  SECURITY
  AUDIT
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum BackupStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum MaintenanceStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

/// The immutable, versioned artifact a `DeploymentHistory` row deploys.
model ReleaseVersion {
  id          String              @id @default(cuid())
  version     String              @unique
  commitSha   String
  description String?
  status      DeploymentStatus    @default(PENDING)
  createdBy   String?
  deployments DeploymentHistory[]
  createdAt   DateTime            @default(now())

  @@index([createdAt])
}

/// One act of delivering a `ReleaseVersion` into an `Environment`.
model DeploymentHistory {
  id               String              @id @default(cuid())
  releaseVersionId String
  releaseVersion   ReleaseVersion      @relation(fields: [releaseVersionId], references: [id], onDelete: Cascade)
  environment      Environment
  status           DeploymentStatus    @default(PENDING)
  initiatedBy      String?
  rolledBackFromId String?
  rolledBackFrom   DeploymentHistory?  @relation("Rollback", fields: [rolledBackFromId], references: [id], onDelete: SetNull)
  rollbackTargets  DeploymentHistory[] @relation("Rollback")
  events           DeploymentEvent[]
  startedAt        DateTime            @default(now())
  completedAt      DateTime?
  notes            String?

  @@index([environment, startedAt])
  @@index([releaseVersionId])
}

/// A single timeline entry within one deployment's pipeline lifecycle.
model DeploymentEvent {
  id                  String            @id @default(cuid())
  deploymentHistoryId String
  deploymentHistory   DeploymentHistory @relation(fields: [deploymentHistoryId], references: [id], onDelete: Cascade)
  type                String
  message             String?
  occurredAt          DateTime          @default(now())

  @@index([deploymentHistoryId, occurredAt])
}

/// A point-in-time status for one monitored component (application/database/API).
model HealthCheck {
  id        String          @id @default(cuid())
  component HealthComponent
  status    HealthStatus
  latencyMs Int?
  detail    Json?
  checkedAt DateTime        @default(now())

  @@index([component, checkedAt])
}

/// A single recorded metric sample (resource usage / performance).
model SystemMetric {
  id         String   @id @default(cuid())
  metricName String
  value      Float
  unit       String
  tags       Json?
  recordedAt DateTime @default(now())

  @@index([metricName, recordedAt])
}

/// The centralized, searchable log store spanning application/database/security/audit categories.
model LogEntry {
  id         String      @id @default(cuid())
  category   LogCategory
  level      LogLevel
  message    String
  requestId  String?
  source     String?
  context    Json?
  occurredAt DateTime    @default(now())

  @@index([category, occurredAt])
  @@index([level, occurredAt])
  @@index([requestId])
}

/// A configured, scheduled infrastructure-level backup policy — distinct from
/// 009-administration-security's per-project application-level `Backup`.
model BackupJob {
  id            String          @id @default(cuid())
  name          String          @unique
  environment   Environment
  scheduleCron  String
  retentionDays Int
  enabled       Boolean         @default(true)
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  history       BackupHistory[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([environment, enabled])
}

/// One executed (or attempted) infrastructure-level backup run.
model BackupHistory {
  id              String       @id @default(cuid())
  backupJobId     String
  backupJob       BackupJob    @relation(fields: [backupJobId], references: [id], onDelete: Cascade)
  status          BackupStatus @default(PENDING)
  sizeBytes       BigInt?
  storageLocation String?
  checksum        String?
  errorMessage    String?
  startedAt       DateTime     @default(now())
  completedAt     DateTime?
  expiresAt       DateTime

  @@index([backupJobId, startedAt])
  @@index([expiresAt])
}

/// A period during which the system is in a controlled operational state.
model MaintenanceWindow {
  id            String            @id @default(cuid())
  status        MaintenanceStatus @default(SCHEDULED)
  reason        String
  notifyMessage String?
  initiatedBy   String
  startedAt     DateTime          @default(now())
  endedAt       DateTime?

  @@index([status])
}

/// An operator-facing alert or notification (health/backup/deployment/maintenance).
model SystemNotification {
  id             String               @id @default(cuid())
  type           String
  severity       NotificationSeverity
  title          String
  message        String
  acknowledgedBy String?
  createdAt      DateTime             @default(now())
  resolvedAt     DateTime?

  @@index([severity, createdAt])
  @@index([resolvedAt])
}

// ---------------------------------------------------------------------------
// specs/008-dashboard-analytics
// ---------------------------------------------------------------------------

/// A user-built dashboard of widgets within a project (US1). `ownerId` is
/// independent of `Project.ownerId` (research.md Decision 7) — a Project
/// Owner can administer any dashboard in their project without being its
/// creator.
model Dashboard {
  id         String             @id @default(cuid())
  projectId  String
  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerId    String
  owner      User               @relation("DashboardOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name       String
  templateId String?
  template   DashboardTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  visibility String             @default("private")
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  widgets          DashboardWidget[]
  shares           DashboardShare[]
  favorites        DashboardFavorite[]
  filters          DashboardFilter[]
  reports          Report[]
  scheduledReports ScheduledReport[]

  @@unique([projectId, name])
  @@index([projectId, updatedAt])
  @@index([ownerId])
}

/// One widget on a dashboard — discriminated by `type`, configured via
/// `config` JSON (research.md Decision 1; "WidgetConfiguration" is this
/// column, not a separate table).
model DashboardWidget {
  id             String            @id @default(cuid())
  dashboardId    String
  dashboard      Dashboard         @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  type           String
  title          String?
  dataSourceType String?
  dataSourceId   String?
  config         Json
  groupId        String?
  group          DashboardWidget?  @relation("WidgetGrouping", fields: [groupId], references: [id], onDelete: SetNull)
  groupMembers   DashboardWidget[] @relation("WidgetGrouping")
  isCollapsed    Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  layouts WidgetLayout[]
  filters DashboardFilter[]

  @@index([dashboardId])
  @@index([dashboardId, groupId])
}

/// One breakpoint-scoped position/size row per widget per tier
/// (research.md Decision 2) — never a single fixed position.
model WidgetLayout {
  id         String          @id @default(cuid())
  widgetId   String
  widget     DashboardWidget @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  breakpoint String
  x          Int
  y          Int
  w          Int
  h          Int

  @@unique([widgetId, breakpoint])
  @@index([widgetId])
}

/// One of the five platform-wide, seeded dashboard blueprints (US8) —
/// not project-scoped.
model DashboardTemplate {
  id               String   @id @default(cuid())
  key              String   @unique
  name             String
  description      String?
  widgetsBlueprint Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  dashboards Dashboard[]
}

/// A per-user access grant on one dashboard (US7/FR-023) — can only
/// broaden a user's access beyond their base project role, never narrow it
/// (research.md Decision 7).
model DashboardShare {
  id              String    @id @default(cuid())
  dashboardId     String
  dashboard       Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation("DashboardShareRecipient", fields: [userId], references: [id], onDelete: Cascade)
  permission      String
  grantedByUserId String
  grantedByUser   User      @relation("DashboardShareGranter", fields: [grantedByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())

  @@unique([dashboardId, userId])
  @@index([userId])
}

/// A user's favorited dashboard (US1/FR-003) — favoriting twice is a no-op,
/// not a duplicate row.
model DashboardFavorite {
  id          String    @id @default(cuid())
  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([dashboardId, userId])
  @@index([userId])
}

/// A global (widgetId null) or widget-scoped filter (US6). A spatial
/// filter's geometry is stored as GeoJSON here, not a PostGIS column — it
/// is always the *input* to an `ST_Intersects`/`ST_Within` call against
/// already-indexed `Feature.geometry`, never itself the subject of a
/// spatial index lookup (data-model.md Migration notes).
model DashboardFilter {
  id          String           @id @default(cuid())
  dashboardId String
  dashboard   Dashboard        @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  widgetId    String?
  widget      DashboardWidget? @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  filterType  String
  config      Json
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([dashboardId])
  @@index([widgetId])
}

/// A generated, persisted report file (US5; research.md Decision 17 — the
/// one entity in this feature that stores file bytes server-side, because a
/// report must remain downloadable across sessions and a scheduled report
/// generates with no browser present).
model Report {
  id                String           @id @default(cuid())
  dashboardId       String
  dashboard         Dashboard        @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledReportId String?
  scheduledReport   ScheduledReport? @relation(fields: [scheduledReportId], references: [id], onDelete: SetNull)
  format            String
  status            String
  fileContent       Bytes?
  sizeBytes         Int?
  errorMessage      String?
  createdAt         DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([dashboardId])
  @@index([scheduledReportId])
}

/// A recurring report generation schedule (US5). `format` excludes `"pdf"`
/// at the Zod layer (research.md Decision 10 — no browser is present when a
/// schedule fires to run `html2canvas`).
model ScheduledReport {
  id          String    @id @default(cuid())
  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  format      String
  recurrence  String
  nextRunAt   DateTime
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  reports Report[]

  @@index([nextRunAt, isActive])
}

/// A short-TTL aggregate cache (research.md Decision 12) — not user-facing;
/// read/written only through `dashboardAnalyticsRepository.ts`'s
/// compute-if-stale-else-serve function. An upsert target, not an
/// append-only log (unlike `Activity`).
model AnalyticsSnapshot {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshotType String
  scopeId      String?
  data         Json
  computedAt   DateTime

  @@unique([projectId, snapshotType, scopeId])
  @@index([projectId, snapshotType])
}
