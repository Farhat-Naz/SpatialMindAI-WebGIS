# Search feature (Phase 2) — Nominatim geocoding provider configuration.
# Nominatim is keyless; these vars only tune the endpoint and outbound request
# behavior. See docs/environment-variables.md for full details.

# Base URL of the Nominatim-compatible geocoding service. Defaults to the
# public OpenStreetMap instance if unset.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Required by Nominatim's usage policy: a custom, application-identifying
# User-Agent sent on every outbound request. Set this to your own
# deployment's contact info before going to production.
SEARCH_USER_AGENT=SpatialMindAI/1.0 (contact: support@spatialmind.ai)

# Maximum outbound requests per second to the geocoding provider, enforced by
# the local rate limiter (Route Handlers). Defaults to 1, matching Nominatim's
# usage policy.
SEARCH_RATE_LIMIT_PER_SECOND=1

# Database foundation (Phase 3) — PostgreSQL + PostGIS connection and the
# interim authentication seam. See specs/003-database-foundation/research.md
# Decisions 1 and 6, and plan.md Section 10 (Deployment).

# PostgreSQL connection string for a database with the PostGIS extension
# available. Server-only — never exposed to the client, never NEXT_PUBLIC_*.
DATABASE_URL="postgresql://user:password@localhost:5432/spatialmind?schema=public"

# Interim authentication seam (Research Decision 6): the id of the seeded
# "default" User row every Route Handler resolves as the acting user, until a
# real authentication module replaces src/server/auth/getCurrentUser.ts.
# Development/test only — must not be relied on in a production deployment.
DEV_USER_ID="dev-user-1"

# Enterprise deployment & production operations (specs/010-deployment-enterprise)
# — all optional; see docs/environment-variables.md for what degrades when unset.

# Non-pooled Postgres connection string used only by `prisma migrate deploy`
# in CI/deploy — not read by the running application.
# DIRECT_URL="postgresql://user:password@localhost:5432/spatialmind?schema=public"

# Upstash Redis REST credentials (REST protocol only — not a redis:// URL).
# Backs the shared cache and the Redis-backed rate-limiter mode.
# UPSTASH_REDIS_REST_URL="https://<your-instance>.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="<your-token>"

# Shared secret required by the scheduled /api/ops/*/run-due endpoints.
# CRON_SECRET="<random-secret>"

# Comma-separated list of origins allowed to call /api/ops/* cross-origin.
# Unset = no cross-origin access allowed.
# ALLOWED_ORIGINS="https://ops.example.com"

# Comma-separated list of User.id values authorized as operators for
# /api/ops/* endpoints. Unset = no one is authorized.
# OPERATOR_USER_IDS="dev-user-1"

# Rejected outright when NODE_ENV=production (spec FR-003).
# DEBUG_MODE=false
